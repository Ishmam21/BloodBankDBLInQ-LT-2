@using task2.CustomNameEF.Tables
@model Donor

@{
    ViewData["Title"] = "Delete Donor";
}

<h2>Delete Donor</h2>

<div class="alert alert-warning">
    <strong>Are you sure you want to delete this donor?</strong>
    <p>This will also delete all donation records for this donor.</p>
</div>

<table class="table table-bordered" style="width: 50%;">
    <tr>
        <th>ID</th>
        <td>@Model.DonorId</td>
    </tr>
    <tr>
        <th>Full Name</th>
        <td>@Model.FullName</td>
    </tr>
    <tr>
        <th>Blood Group</th>
        <td>@Model.BloodGroup</td>
    </tr>
    <tr>
        <th>Contact No</th>
        <td>@Model.ContactNo</td>
    </tr>
    <tr>
        <th>City</th>
        <td>@Model.City</td>
    </tr>
    <tr>
        <th>Last Donation Date</th>
        <td>@(Model.LastDonationDate.HasValue ? Model.LastDonationDate.Value.ToString("yyyy-MM-dd") : "N/A")</td>
    </tr>
</table>

<form action="/Donor/Delete" method="post">
    <input type="hidden" name="Decision" value="Yes" />
    <input type="hidden" name="DonorId" value="@Model.DonorId" />
    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a href="/Donor" class="btn btn-secondary">Cancel</a>
</form>
