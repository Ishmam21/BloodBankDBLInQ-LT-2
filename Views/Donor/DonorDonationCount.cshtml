@using task2.Models
@model List<DonorDonationCountViewModel>

@{
    ViewData["Title"] = "Donor Donation Count";
}

<h2>Donors with Total Donation Count</h2>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No donors found.</div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Full Name</th>
                <th>Blood Group</th>
                <th>City</th>
                <th>Total Donations</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.DonorId</td>
                    <td>@item.FullName</td>
                    <td>@item.BloodGroup</td>
                    <td>@item.City</td>
                    <td>@item.TotalDonations</td>
                </tr>
            }
        </tbody>
    </table>
}
