@using task2.CustomNameEF.Tables
@model List<Donor>

@{
    ViewData["Title"] = "Donors Sorted by Last Donation Date";
}

<h2>Donors Sorted by Last Donation Date (Most Recent First)</h2>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No donors found.</div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Full Name</th>
                <th>Blood Group</th>
                <th>Contact No</th>
                <th>City</th>
                <th>Last Donation Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var donor in Model)
            {
                <tr>
                    <td>@donor.DonorId</td>
                    <td>@donor.FullName</td>
                    <td>@donor.BloodGroup</td>
                    <td>@donor.ContactNo</td>
                    <td>@donor.City</td>
                    <td>@(donor.LastDonationDate.HasValue ? donor.LastDonationDate.Value.ToString("yyyy-MM-dd") : "N/A")</td>
                </tr>
            }
        </tbody>
    </table>
}
